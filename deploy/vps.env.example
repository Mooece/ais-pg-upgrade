# 已通过 A 记录指向此 VPS 的域名；仅在 IPv6 可用时配置 AAAA 记录。
DOMAIN=api.example.com

# API 监听端口，应仅通过 Caddy 在 VPS 本机反向代理访问。
AISTUDIO_PORT=8080

# 运行配置保存在 Git 忽略的 config.local.yaml，避免 git pull 覆盖面板设置。
AISTUDIO_CONFIG_FILE=config.local.yaml

# 管理面板密码，请替换为足够长且随机的密码。
# API 客户端应使用管理面板中单独创建的 API Key。
AISTUDIO_WEB_PASSWORD=replace-this-with-a-long-random-secret

# 可选：Google AI Studio 无法直连时填写 HTTP/SOCKS5 出口代理。
# AISTUDIO_PROXY=http://127.0.0.1:7890

# 生产环境不要打开请求报文转储。
AISTUDIO_DUMP_REQUESTS=0
AISTUDIO_DUMP_FILE=0
